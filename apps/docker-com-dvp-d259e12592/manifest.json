    "spec": {
      "base": {
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "DatasetModel": {
                  "properties": {
                    "name": {
                      "$ref": "#/components/schemas/DatasetType"
                    },
                    "timespans": {
                      "items": {
                        "$ref": "#/components/schemas/TimespanType"
