                  "description": {
                    "maxLength": 255,
                    "minLength": 0,
                    "pattern": "^[A-Za-z0-9 _\\-]*$",
                    "type": "string"
                  },
                  "gitAccessToken": {
                    "type": "string"
                  },
                  "gitUrl": {
                    "description": "The git clone URL.",
