              },
              "/enable-user": {
                "post": {
                  "description": "This route allows you to enable a user's vpn access. This route can only be called using your user's Bearer Auth token.",
                  "operationId": "EnableUser",
                  "requestBody": {
                    "content": {
                      "application/json": {
