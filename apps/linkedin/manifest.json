  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "linkedin"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.linkedin.com",
        "headers": {
          "LinkedIn-Version": "202610",
          "X-Restli-Protocol-Version": "2.0.0"
        },
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "MemberPost": {
                  "properties": {
                    "author": {
                      "description": "urn:li:person:{sub} of the authenticated member",
                      "pattern": "^urn:li:person:[A-Za-z0-9_-]+$",
                      "type": "string"
                    },
                    "commentary": {
                      "description": "Post text. LinkedIn's little-text format reserves characters such as ( ) [ ] { } < > @ | ~ _ * which must be escaped with a backslash.",
                      "maxLength": 3000,
                      "type": "string"
                    },
                    "distribution": {
                      "properties": {
                        "feedDistribution": {
                          "default": "MAIN_FEED",
                          "enum": [
                            "MAIN_FEED",
                            "NONE"
                          ],
                          "type": "string"
                        },
                        "targetEntities": {
                          "default": [],
                          "items": {
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "thirdPartyDistributionChannels": {
                          "default": [],
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "feedDistribution"
                      ],
                      "type": "object"
                    },
                    "isReshareDisabledByAuthor": {
                      "default": false,
                      "type": "boolean"
                    },
                    "lifecycleState": {
                      "default": "PUBLISHED",
                      "enum": [
                        "PUBLISHED"
                      ],
                      "type": "string"
                    },
                    "visibility": {
                      "default": "PUBLIC",
                      "enum": [
                        "PUBLIC",
                        "CONNECTIONS",
                        "LOGGED_IN"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "author",
                    "commentary",
                    "visibility",
                    "distribution",
                    "lifecycleState"
                  ],
                  "type": "object"
                },
                "UserInfo": {
                  "properties": {
                    "email": {
                      "format": "email",
                      "type": "string"
                    },
                    "email_verified": {
                      "type": "boolean"
                    },
                    "family_name": {
                      "type": "string"
                    },
                    "given_name": {
                      "type": "string"
                    },
                    "locale": {
                      "description": "Member locale. Documented as text (sample: en-US); an object {country, language} is also accepted so a response in that form still validates",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "properties": {
                            "country": {
                              "type": "string"
                            },
                            "language": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "picture": {
                      "format": "uri",
                      "type": "string"
                    },
                    "sub": {
                      "description": "Member identifier; build the author URN as urn:li:person:{sub}",
                      "type": "string"
                    }
                  },
                  "required": [
                    "sub"
                  ],
                  "type": "object"
                }
              },
              "securitySchemes": {
                "LinkedInOAuth": {
                  "description": "LinkedIn 3-legged OAuth 2.0 authorization code flow. Self-serve access tokens last 60 days; programmatic refresh tokens are only issued to approved partners, so members reconnect when the token expires.",
                  "flows": {
                    "authorizationCode": {
                      "authorizationUrl": "https://www.linkedin.com/oauth/v2/authorization",
                      "scopes": {
                        "email": "Primary email address",
                        "openid": "Use OpenID Connect to sign in",
                        "profile": "Name and photo",
                        "w_member_social": "Create, modify and delete posts on behalf of the member"
                      },
                      "tokenUrl": "https://www.linkedin.com/oauth/v2/accessToken"
                    }
                  },
                  "type": "oauth2"
                }
              }
            },
            "info": {
              "description": "Minimal operation set for LinkedIn's self-serve products Sign In with LinkedIn using OpenID Connect and Share on LinkedIn, written by Ragentic from LinkedIn's public documentation (see x-ragentic-origins). This is NOT an official LinkedIn definition and is not endorsed by LinkedIn. Organization (company page) posting, reading posts and other Community Management features require LinkedIn product approval and are deliberately not included.",
              "title": "LinkedIn member sign-in and posting (independent, hand-built)",
              "version": "202610",
              "x-ragentic-not-official": true,
              "x-ragentic-origins": [
                "https://learn.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/sign-in-with-linkedin-v2",
                "https://learn.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/share-on-linkedin",
                "https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-api",
                "https://learn.microsoft.com/en-us/linkedin/shared/authentication/authorization-code-flow",
                "https://learn.microsoft.com/en-us/linkedin/marketing/versioning"
              ]
            },
            "openapi": "3.0.3",
            "paths": {
              "/rest/posts": {
                "post": {
                  "description": "Creates a post authored by the authenticated member (Share on LinkedIn, scope w_member_social). `author` must be `urn:li:person:{sub}` where sub comes from getUserInfo. The connector sends the LinkedIn-Version and X-Restli-Protocol-Version headers. On success LinkedIn answers 201 with the new post URN in the x-restli-id response header and an empty body. Posting as an organization requires the Community Management API and is not supported by this definition.",
                  "operationId": "createPost",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/MemberPost"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "201": {
                      "description": "Post created; the post URN is in the x-restli-id header",
                      "headers": {
                        "x-restli-id": {
                          "description": "URN of the created post, for example urn:li:share:{id} or urn:li:ugcPost:{id}",
                          "schema": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "401": {
                      "description": "Missing, expired or revoked access token"
                    },
                    "403": {
                      "description": "The token lacks w_member_social or author is not the authenticated member"
                    },
                    "422": {
                      "description": "Invalid post content"
                    }
                  },
                  "security": [
                    {
                      "LinkedInOAuth": [
                        "w_member_social"
                      ]
                    }
                  ],
                  "summary": "Create a post as the signed-in member"
                }
              },
              "/rest/posts/{postUrn}": {
                "delete": {
                  "description": "Deletes a post by its URN (as returned in x-restli-id by createPost). The URN must be URL-encoded in the path. Deletion is idempotent and answers 204.",
                  "operationId": "deletePost",
                  "parameters": [
                    {
                      "description": "URL-encoded post URN, for example urn%3Ali%3Ashare%3A6844785523593134080",
                      "in": "path",
                      "name": "postUrn",
                      "required": true,
                      "schema": {
                        "pattern": "^urn(%3A|:)li(%3A|:)(share|ugcPost)(%3A|:)[0-9]+$",
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "204": {
                      "description": "Deleted (or already deleted)"
                    },
                    "401": {
                      "description": "Missing, expired or revoked access token"
                    },
                    "403": {
                      "description": "The post does not belong to the authenticated member"
                    }
                  },
                  "security": [
                    {
                      "LinkedInOAuth": [
                        "w_member_social"
                      ]
                    }
                  ],
                  "summary": "Delete a post created by the signed-in member"
                }
              },
              "/v2/userinfo": {
                "get": {
                  "description": "Returns the OpenID Connect claims of the authenticated member. The `sub` claim is the member ID used to build the person URN `urn:li:person:{sub}` for createPost. Requires the openid and profile scopes; email and email_verified require the email scope.",
                  "operationId": "getUserInfo",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/UserInfo"
                          }
                        }
                      },
                      "description": "OpenID Connect userinfo claims"
                    },
                    "401": {
                      "description": "Missing, expired or revoked access token"
                    }
                  },
                  "security": [
                    {
                      "LinkedInOAuth": [
                        "openid",
                        "profile"
                      ]
                    }
                  ],
                  "summary": "Get the signed-in member's OpenID Connect profile"
                }
              }
            },
            "servers": [
              {
                "url": "https://api.linkedin.com"
              }
            ]
          }
        },
        "type": "app"
      },
      "category": "app",
      "connector": {},
      "description": "Connect a LinkedIn member account with an independent Ragentic integration: sign-in profile and member posts (self-serve products only). Not affiliated with or endorsed by LinkedIn.",
      "status": "published",
      "title": "LinkedIn"
    }
  },
