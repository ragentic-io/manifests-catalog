    "/xrpc/com.atproto.repo.createRecord": {
      "post": {
        "operationId": "createRecord",
        "summary": "Create a record (for example a post)",
        "description": "Create a single new repository record. Requires auth, implemented by PDS.",
        "security": [
          {
            "atprotoSession": []
          }
        ],
        "x-lexicon": "com.atproto.repo.createRecord",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repo": {
                    "description": "The handle or DID of the repo (aka, current account).",
                    "type": "string",
                    "format": "at-identifier"
                  },
                  "collection": {
                    "description": "The NSID of the record collection.",
                    "type": "string",
                    "format": "nsid"
                  },
                  "rkey": {
                    "description": "The Record Key.",
                    "type": "string",
                    "maxLength": 512,
                    "format": "record-key"
                  },
                  "validate": {
                    "description": "Can be set to 'false' to skip Lexicon schema validation of record data, 'true' to require it, or leave unset to validate only for known Lexicons.",
                    "type": "boolean"
                  },
                  "record": {
                    "type": "object",
                    "properties": {
                      "$type": {
                        "type": "string",
                        "enum": [
                          "app.bsky.feed.post"
                        ]
                      },
                      "text": {
                        "description": "The primary post content. May be an empty string, if there are embeds.",
                        "type": "string",
                        "maxLength": 3000
                      },
                      "entities": {
                        "description": "DEPRECATED: replaced by app.bsky.richtext.facet.",
                        "type": "array",
                        "items": {
                          "description": "Lexicon object app.bsky.feed.post#entity.",
                          "type": "object",
                          "x-lexicon-ref": "app.bsky.feed.post#entity"
                        }
                      },
                      "facets": {
                        "description": "Annotations of text (mentions, URLs, hashtags, etc)",
                        "type": "array",
                        "items": {
                          "description": "Lexicon object app.bsky.richtext.facet.",
                          "type": "object",
                          "x-lexicon-ref": "app.bsky.richtext.facet"
                        }
                      },
                      "reply": {
                        "description": "Lexicon object app.bsky.feed.post#replyRef.",
                        "type": "object",
                        "x-lexicon-ref": "app.bsky.feed.post#replyRef"
                      },
                      "embed": {
                        "type": "object",
                        "x-lexicon-union": [
                          "app.bsky.embed.images",
                          "app.bsky.embed.video",
                          "app.bsky.embed.gallery",
                          "app.bsky.embed.external",
                          "app.bsky.embed.record",
                          "app.bsky.embed.recordWithMedia"
                        ],
                        "description": "One of: app.bsky.embed.images, app.bsky.embed.video, app.bsky.embed.gallery, app.bsky.embed.external, app.bsky.embed.record, app.bsky.embed.recordWithMedia (identified by $type)."
                      },
                      "langs": {
                        "description": "Indicates human language of post primary text content.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "language"
                        },
                        "maxItems": 3
                      },
                      "labels": {
                        "description": "Self-label values for this post. Effectively content warnings. One of: com.atproto.label.defs#selfLabels (identified by $type).",
                        "type": "object",
                        "x-lexicon-union": [
                          "com.atproto.label.defs#selfLabels"
                        ]
                      },
                      "tags": {
                        "description": "Additional hashtags, in addition to any included in post text and facets.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 640
                        },
                        "maxItems": 8
                      },
                      "createdAt": {
                        "description": "Client-declared timestamp when this post was originally created.",
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "$type",
                      "text",
                      "createdAt"
                    ],
                    "description": "The record itself; must contain $type. For a post use collection app.bsky.feed.post and this shape (lexicon app.bsky.feed.post)."
                  },
                  "swapCommit": {
                    "description": "Compare and swap with the previous commit by CID.",
                    "type": "string",
                    "format": "cid"
                  }
                },
                "required": [
                  "repo",
                  "collection",
                  "record"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "at-uri"
                    },
                    "cid": {
                      "type": "string",
                      "format": "cid"
                    },
                    "commit": {
                      "description": "Lexicon object com.atproto.repo.defs#commitMeta.",
                      "type": "object",
                      "x-lexicon-ref": "com.atproto.repo.defs#commitMeta"
                    },
                    "validationStatus": {
                      "type": "string",
                      "x-lexicon-knownValues": [
                        "valid",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "uri",
                    "cid"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "XRPC error {error, message}"
          },
          "401": {
            "description": "Missing or expired session"
          }
        }
      }
    },
