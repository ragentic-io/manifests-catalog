    "/xrpc/com.atproto.repo.uploadBlob": {
      "post": {
        "operationId": "uploadBlob",
        "summary": "Upload a blob (image or video) for a record",
        "description": "Upload a new blob, to be referenced from a repository record. The blob will be deleted if it is not referenced within a time window (eg, minutes). Blob restrictions (mimetype, size, etc) are enforced when the reference is created. Requires auth, implemented by PDS.",
        "security": [
          {
            "atprotoSession": []
          }
        ],
        "x-lexicon": "com.atproto.repo.uploadBlob",
        "requestBody": {
          "required": true,
          "description": "Raw blob bytes; set Content-Type to the blob's MIME type. Size limits are set by the PDS.",
          "content": {
            "*/*": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blob": {
                      "type": "object",
                      "x-lexicon-type": "blob",
                      "description": "Blob reference: {$type: blob, ref: {$link: CID}, mimeType, size}."
                    }
                  },
                  "required": [
                    "blob"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "XRPC error {error, message}"
          },
